# Copy to ~/.config/herdr-web/env (deploy/install.sh does this) and edit.

# (systemd reads this file: no inline comments, comments on their own lines only)

# --- the herdr server we wrap ---
# Path to herdr; empty = found on PATH.
HERDR_BIN=
# Which herdr session to show.
HERDR_SESSION=default
HERDR_CLI_TIMEOUT=15

# --- service ---
# 127.0.0.1 = only this machine. To use it from a phone, put it behind a reverse
# proxy with TLS, or bind to a VPN/LAN address. There is NO login: anyone who can
# reach this port can type into your panes. Read docs/NETWORKING.md first.
HERDRWEB_HOST=127.0.0.1
HERDRWEB_PORT=8086
# 0 = read-only (look, don't touch). 1 = typing, keys, dictation, inbox replies.
HERDRWEB_ENABLE_WRITES=0
# Host names you reach it by (comma-separated). Requests for any other Host are
# refused, which stops DNS-rebinding attacks. Add your proxy/VPN name here,
# e.g. wheelhouse.example.com or my-box.tailnet-name.ts.net. "*" disables the check.
HERDRWEB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Extra browser origins allowed to open the WebSockets / call mutating API
# (comma-separated). The app's own origin is always allowed.
HERDRWEB_ALLOWED_ORIGINS=
# Cross-origin read access (CORS) for a separate dev server; empty = none.
HERDRWEB_CORS=
# How many browser terminals may be open at once (each is a herdr client).
HERDRWEB_MAX_TERMINALS=8

# --- push notifications ---
# VAPID key + subscriptions are kept here (created on first use, mode 0600).
HERDRWEB_STATE_DIR=~/.local/state/herdr-web
# Contact sent to push services (Apple/Google/Mozilla) with each push: set your
# own mailto: address or https: URL.
HERDRWEB_PUSH_CONTACT=mailto:admin@example.com
# 1 = notifications say "An agent is waiting" without naming the pane.
HERDRWEB_PUSH_PRIVATE=0
# Only the browsers' push services are accepted as endpoints. Add hosts here for
# a self-hosted push service (host or host:port).
HERDRWEB_PUSH_HOSTS=
HERDRWEB_PUSH_MAX_SUBS=20

# --- image paste ---
# Largest pasted/picked image accepted, in MB. Images are saved under
# HERDRWEB_STATE_DIR/uploads and pruned after 7 days (or past the newest 200).
HERDRWEB_UPLOAD_MAX_MB=20

# --- herdr location (rarely needed) ---
# HERDR_HOME=~/.config/herdr
