# System unit, installed by deploy/install.sh as /etc/systemd/system/herdr-web.service
# (@APP_DIR@, @SERVICE_USER@, @SERVICE_GROUP@, @SERVICE_HOME@, @CONF_DIR@ are filled in).
# Wants=/After= herdr.service orders startup only; there is deliberately no
# hard dependency on it, so the two can be restarted independently.
[Unit]
Description=herdr web (Wheelhouse): browser client for herdr
Wants=herdr.service
After=herdr.service network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@/backend
EnvironmentFile=@CONF_DIR@/env
Environment=HERDRWEB_STATIC=@APP_DIR@/backend/static
Environment=HOME=@SERVICE_HOME@
# herdr lives in ~/.local/bin by default; keep it on PATH for the PTY client.
Environment=PATH=@SERVICE_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec @APP_DIR@/backend/.venv/bin/uvicorn app.main:app --host "$HERDRWEB_HOST" --port "$HERDRWEB_PORT"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
